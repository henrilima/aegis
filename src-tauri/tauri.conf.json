{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aegis",
  "version": "2.1.1",
  "identifier": "com.aegis.system",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sistema Aegis",
        "width": 1000,
        "minWidth": 1000,
        "height": 700,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "maximized": false,
        "visible": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com https://brasilapi.com.br https://openlibrary.org https://www.googleapis.com https://books.googleapis.com https://discord.com https://*.discord.com https://ptb.discord.com; img-src 'self' data: https://covers.openlibrary.org https://*.openlibrary.org https://www.google.com https: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../aegis.changelog", "../public/sounds/*"],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/henrilima/aegis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MzkzOTJFODE4ODk3MjAKUldRZ2w0aUJMams1UnVodVBRSnNFbGF0Ykg4QnhKOFRHQUM4bndZemF0RjdqUXFyZkZDQkdrTnMK"
    }
  }
}
