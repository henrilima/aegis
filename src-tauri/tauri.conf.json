{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aegis",
  "version": "0.1.0",
  "identifier": "com.aegis.system",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sistema Aegis",
        "width": 1000,
        "minWidth": 1000,
        "height": 700,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "maximized": false,
        "visible": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
