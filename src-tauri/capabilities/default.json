{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-zoom",
    "password-management",
    "pomodoro-management",
    "alarm-management",
    "habit-management",
    "note-management",
    "study-management",
    "sleep-management",
    "calendar-management",
    "statistic-management",
    "reading-management",
    "dictionary-management",
    "movie-management",
    "task-management",
    "flashcard-management",
    "global-management",
    "autostart:default",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-register-listener",
    "notification:allow-register-action-types",
    "notification:allow-cancel",
    "notification:allow-get-pending",
    "notification:allow-get-active",
    "notification:allow-remove-active",
    "notification:allow-check-permissions",
    "notification:allow-permission-state",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:read-all",
    "fs:allow-desktop-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-document-write-recursive",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "store:default",
    "log:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://*.discord.com/api/webhooks/*" },
        { "url": "https://discord.com/api/webhooks/*" },
        { "url": "https://wttr.in/*" },
        { "url": "https://geocoding-api.open-meteo.com/*" },
        { "url": "https://api.dictionaryapi.dev/*" },
        { "url": "https://translate.googleapis.com/*" },
        { "url": "https://api.dicionario-aberto.net/*" },
        { "url": "https://api.themoviedb.org/*" },
        { "url": "https://www.googleapis.com/*" }
      ]
    }
  ]
}
